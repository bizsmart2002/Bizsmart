# HU02 - OAuth 2.0 con Google. Se crean en https://console.cloud.google.com
# (APIs & Services > Credentials > OAuth client ID > Web application).
# GOOGLE_CALLBACK_URL debe registrarse ahí EXACTAMENTE igual, y debe apuntar
# al Gateway (puerto 3000), no directo a auth-service, porque el navegador
# del usuario solo conoce el Gateway.
GOOGLE_CLIENT_ID=changeme-google-client-id
GOOGLE_CLIENT_SECRET=changeme-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
FRONTEND_URL=http://localhost:4200
AUTH_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
INVENTORY_SERVICE_URL=http://localhost:3003
SALES_SERVICE_URL=http://localhost:3004
CUSTOMER_SERVICE_URL=http://localhost:3005
REPORTING_SERVICE_URL=http://localhost:3006
AI_SERVICE_URL=http://localhost:3007
